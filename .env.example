VITE_WS_URL=ws://localhost:8000/web/stream
VITE_GOOGLE_MAPS_API_KEY=your_key_here

# Optional Google sign-in (Supabase Auth).
#
# Leave these unset and the app runs exactly as before, minus the account
# button — everyone is a guest, and the agent forgets them when they leave.
# Set them and travelers can sign in with Google in one tap, after which the
# preferences the agent picks up follow them to their next visit.
#
# Both values come from the Supabase dashboard (Project Settings -> API); the
# anon key is public by design and is safe to ship in the bundle. You also have
# to enable the Google provider under Authentication -> Providers, and add this
# app's URL (including the vite `base`, e.g. https://agent.nodestra.com/oakland/)
# to Authentication -> URL Configuration -> Redirect URLs.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
